APP_NAME=SENDAPTNAPT
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://sendaptnapt.senelec.sn

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Base de donnÃ©es MySQL principale
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sendaptnapt
DB_USERNAME=root
DB_PASSWORD=

# Oracle HR (synchronisation utilisateurs)
ORACLE_HOST=oracle-server.senelec.sn
ORACLE_PORT=1521
ORACLE_DATABASE=HR
ORACLE_USERNAME=
ORACLE_PASSWORD=
ORACLE_SERVICE_NAME=HR
ORACLE_CHARSET=AL32UTF8

# SQL Server GMAO (Ã©quipements)
SQLSRV_GMAO_HOST=sqlserver.senelec.sn
SQLSRV_GMAO_PORT=1433
SQLSRV_GMAO_DATABASE=GMAO
SQLSRV_GMAO_USERNAME=
SQLSRV_GMAO_PASSWORD=

# LDAP (authentification)
LDAP_LOGGING=false
LDAP_CONNECTION=default
LDAP_HOST=ldap.senelec.sn
LDAP_PORT=389
LDAP_BASE_DN="dc=senelec,dc=sn"
LDAP_USERNAME="cn=admin,dc=senelec,dc=sn"
LDAP_PASSWORD=
LDAP_TIMEOUT=5
LDAP_SSL=false
LDAP_TLS=false

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Configuration Email SENELEC
MAIL_MAILER=smtp
MAIL_HOST=smtp.senelec.sn
MAIL_PORT=587
MAIL_USERNAME=sendaptnapt@senelec.sn
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="sendaptnapt@senelec.sn"
MAIL_FROM_NAME="SENDAPTNAPT"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
