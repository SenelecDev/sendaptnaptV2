# ==============================================
# SENDAPTNAPT - Configuration Docker Production
# Copier ce fichier en .env sur le serveur
# ==============================================

APP_NAME="SENDAPTNAPT"
APP_ENV=production
APP_KEY=base64:GENERATE_NEW_KEY_WITH_PHP_ARTISAN_KEY_GENERATE
APP_DEBUG=false
APP_URL=http://sendaptnapt.senelec.sn

# Timezone
APP_TIMEZONE=Africa/Dakar
APP_LOCALE=fr
APP_FALLBACK_LOCALE=en

# Logging
LOG_CHANNEL=daily
LOG_LEVEL=error
LOG_DEPRECATIONS_CHANNEL=null

# ==============================================
# Base de données PostgreSQL
# ==============================================
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=sendaptnapt
DB_USERNAME=sendaptnapt
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ==============================================
# Cache et Sessions (Redis)
# ==============================================
CACHE_DRIVER=redis
CACHE_PREFIX=sendaptnapt_
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
QUEUE_CONNECTION=redis

REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_CLIENT=phpredis

# ==============================================
# Email SMTP (Senelec)
# ==============================================
MAIL_MAILER=smtp
MAIL_HOST=smtp.senelec.sn
MAIL_PORT=587
MAIL_USERNAME=sendaptnapt@senelec.sn
MAIL_PASSWORD=CHANGE_ME_MAIL_PASSWORD
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=sendaptnapt@senelec.sn
MAIL_FROM_NAME="SENDAPTNAPT"

# ==============================================
# LDAP Senelec
# ==============================================
LDAP_HOST=ldap.senelec.sn
LDAP_PORT=389
LDAP_BASE_DN=dc=senelec,dc=sn
LDAP_USERNAME=cn=app_sendaptnapt,ou=Applications,dc=senelec,dc=sn
LDAP_PASSWORD=CHANGE_ME_LDAP_PASSWORD
LDAP_SSL=false
LDAP_TLS=true

# ==============================================
# Oracle HR (si nécessaire)
# ==============================================
ORACLE_HOST=oracle-hr.senelec.sn
ORACLE_PORT=1521
ORACLE_SERVICE=HRPROD
ORACLE_USERNAME=app_sendaptnapt
ORACLE_PASSWORD=CHANGE_ME_ORACLE_PASSWORD

# ==============================================
# Sécurité
# ==============================================
BCRYPT_ROUNDS=12
SANCTUM_STATEFUL_DOMAINS=sendaptnapt.senelec.sn

# ==============================================
# Ports Docker (optionnel)
# ==============================================
APP_PORT=80
APP_SSL_PORT=443
